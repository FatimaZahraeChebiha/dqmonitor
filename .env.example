# Copy to .env and fill in real values. Never commit the real .env file.

MYSQL_DATABASE=data_quality_db
MYSQL_PASSWORD=change-me

# Generate a real random secret for production, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Shared secret used only by the Python quality_check job to call back into the backend
INTERNAL_API_KEY=change-me-to-a-long-random-string

ADMIN_EMAIL=admin@dqmonitor.com
ADMIN_PASSWORD=change-me-on-first-login

# Comma-separated list of origins allowed to call the API directly (dev only -
# in the docker-compose setup, nginx proxies /api same-origin so this isn't hit)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Data-processing (Python quality_check job) ---
# Only used when running the backend directly on the host (no Docker): it then
# spawns quality_check.py itself via ProcessBuilder. Inside docker-compose, the
# backend instead calls the data-processing container over HTTP
# (ANALYSIS_SERVICE_URL is set automatically in docker-compose.yml), so these
# two variables have no effect there.
PYTHON_EXECUTABLE=python
PYTHON_SCRIPT_PATH=../data-processing/spark_jobs/quality_check.py
BACKEND_BASE_URL=http://localhost:8080

# --- Mail (forgot/reset password, low-quality-score alerts) ---
# Defaults target the MailHog container in docker-compose (dev-only SMTP
# catcher, web UI at http://localhost:8025, nothing actually leaves the box).
# Override with real SMTP credentials (e.g. Gmail smtp.gmail.com:587 with an
# app password) for actual delivery - never commit real values here.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@dqmonitor.local
FRONTEND_URL=http://localhost:4200

# --- Grafana (ops dashboards, reads MySQL directly via a read-only user) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-on-first-login
# Password for the read-only 'grafana' MySQL user, provisioned by mysql-init/
# on first container init - change it for anything beyond local dev.
GRAFANA_MYSQL_PASSWORD=change-me

# --- AI Assistant ---
# Provider abstraction: "ollama" (default, free/local/offline), "anthropic", or "openai".
# Switching providers in production is a config-only change - no code changes needed.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Only needed when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Only needed when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Host port overrides (optional) ---
# Change these if the defaults collide with something else already running on
# your machine (e.g. a local MySQL install on 3306, or another app on 8080).
# MYSQL_HOST_PORT=13306
# BACKEND_HOST_PORT=18080
# FRONTEND_HOST_PORT=14200
# MAILHOG_HOST_PORT=18025
# OLLAMA_HOST_PORT=11435
# AIRFLOW_HOST_PORT=18090
# GRAFANA_HOST_PORT=13000
